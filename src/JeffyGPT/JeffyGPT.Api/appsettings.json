{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JeffyGPT": {
    "Mcp": {
      "Servers": [
        {
          "Id": "jeffymcp",
          "Enabled": true,
          "Required": true,
          "Transport": "Stdio",
          "Command": "dotnet",
          "Arguments": [
            "../../JeffyMCP/bin/Debug/net10.0/JeffyMCP.dll"
          ],
          "WorkingDirectory": "../../JeffyMCP",
          "Policy": {
            "AllowAllTools": true
          }
        }
      ]
    }
  }
}
