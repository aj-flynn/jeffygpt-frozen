        "ASPNETCORE_ENVIRONMENT": "Development",
        "JeffyGPT__Assistant__Provider": "OpenAiCompatible"
      }
    },
    "http-openai": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5008",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "JeffyGPT__Assistant__Provider": "OpenAiCompatible"
      }
