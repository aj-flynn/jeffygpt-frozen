{
  "name": "jeffygpt-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode production",
    "lint": "oxlint",
    "format": "prettier --write --config .prettierrc.json --ignore-path .prettierignore . ../../../.userdocs",
    "format:check": "prettier --check --config .prettierrc.json --ignore-path .prettierignore . ../../../.userdocs",
    "preview": "vite preview",
    "test": "vitest run",
    "crap": "vitest run --coverage && node scripts/crap-score.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "happy-dom": "^20.0.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}
